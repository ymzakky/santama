---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MemberProfileCard from '../../components/MemberProfileCard.astro';
import HeroSection from '../../components/HeroSection.astro';
import { getAllMemberProfiles } from '../../lib/microcms';

const members = await getAllMemberProfiles();
---

<BaseLayout title="会員紹介">
  <Breadcrumb items={[{ label: '会員紹介' }]} />

  <HeroSection title="会員紹介" subtitle="東京中小企業家同友会 三多摩支部の会員企業を、経営者インタビューでご紹介します。多摩地域を中心に、さまざまな業種の中小企業が活躍しています。" />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {members.map((member) => (
          <MemberProfileCard member={member} />
        ))}
      </div>

      <p class="mt-8 text-sm text-text-light">※ 掲載情報はインタビュー当時のものです。</p>
    </div>
  </section>
</BaseLayout>
