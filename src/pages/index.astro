---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestPosts, categoryLabels } from '../lib/microcms';
import { withBase } from '../lib/path';
import { formatDate } from '../lib/date';

const latestPosts = await getLatestPosts(3);

// ---- ヒーロースライダー (画像は public/images/hero/ に slide1.jpg ... を置くと差し替わる) ----
const slides = [
  {
    image: '/images/hero/slide1.jpg',
    title: '経営者の悩みは経営者に聞け！',
    subtitle: '経営者からの本気のアドバイスで成長する',
    ctaLabel: '経営者の気づきとまなび',
    ctaHref: '/event/',
  },
  {
    image: '/images/hero/slide2.jpg',
    title: '経営者は孤独ではいけない！',
    subtitle: '本気で語り合い、共に学び合う仲間を作る',
    ctaLabel: '経営者支援サービス',
    ctaHref: '/our-services/',
  },
  {
    image: '/images/hero/slide3.jpg',
    title: '生の経営体験報告が自社を変える！',
    subtitle: '経営課題を乗り越えた体験が仲間を強くする',
    ctaLabel: '最新活動状況',
    ctaHref: '/posts/',
  },
];

// ---- 三多摩支部とは 3カラム ----
const features = [
  {
    image: '/images/230220_ph01.jpg',
    title: '幅広い年齢層・業種が参加',
    text: '東京中小企業家 三多摩支部では、多数の中小企業の経営者の皆様にご入会頂いております。多様な会員同士の交流の中で、経営者の学びや他業種への理解を深めることができます。',
    href: '/about/',
  },
  {
    image: '/images/230220_ph02.jpg',
    title: '経営者同士の学びの場',
    text: '毎月開催される例会では、同友会会員や会外から講師をお呼びして、優れた経営体験や経営者としての悩みなど、経営者ならではのお話をお聞きして、学びを深めています。',
    href: '/event/',
  },
  {
    image: '/images/230220_ph03_2.jpg',
    title: '経営者に寄り添ったセミナー',
    text: '支部活動とは別に同友会本部では委員会活動があり、採用や自社の経営計画の作成、人材の育成など、経営者の悩みを解決するためにセミナー等の活動を行っております。',
    href: '/our-services/',
  },
];
---

<BaseLayout title="トップページ">

  <!-- ========== Hero Slider ========== -->
  <section
    class="relative w-full h-[420px] sm:h-[520px] md:h-[640px] overflow-hidden bg-black"
    role="region"
    aria-label="メインスライダー"
    aria-roledescription="carousel"
    id="hero-slider"
  >
    <div class="slider-track flex h-full transition-transform duration-700 ease-in-out" style={`width: ${slides.length * 100}%`}>
      {slides.map((slide) => (
        <div class="relative h-full flex-shrink-0 bg-gradient-to-br from-black via-black to-accent" style={`width: ${100 / slides.length}%`}>
          <!-- 右半分にだけ画像を表示 -->
          <div
            class="hero-image absolute inset-y-0 right-0 w-1/2 bg-cover bg-center"
            style={`background-image: url('${withBase(slide.image)}');`}
          ></div>
          <!-- テキスト＆CTA（左半分） -->
          <div class="relative h-full flex items-center">
            <div class="text-white w-1/2 pl-6 sm:pl-10 md:pl-16 pr-6 md:pr-10">
              <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold mb-4 md:mb-6 leading-tight drop-shadow-lg">
                {slide.title}
              </h2>
              <div class="w-24 md:w-32 h-1 bg-primary mb-4 md:mb-6"></div>
              <p class="text-sm sm:text-base md:text-lg mb-6 md:mb-8 leading-relaxed text-white/90">
                {slide.subtitle}
              </p>
              <a
                href={withBase(slide.ctaHref)}
                class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 bg-primary text-white font-bold rounded shadow-lg hover:bg-primary-dark transition-colors text-sm sm:text-base"
              >
                {slide.ctaLabel}
                <span class="ml-1">→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <!-- 前へ -->
    <button
      class="slider-prev absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center bg-white/70 hover:bg-white text-accent rounded-full shadow transition-colors"
      aria-label="前のスライド"
      type="button"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <!-- 次へ -->
    <button
      class="slider-next absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center bg-white/70 hover:bg-white text-accent rounded-full shadow transition-colors"
      aria-label="次のスライド"
      type="button"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
    <!-- ドットインジケータ -->
    <div class="absolute bottom-4 right-4 sm:right-6 flex gap-2 z-10">
      {slides.map((_, i) => (
        <button
          class:list={['slider-dot w-6 sm:w-8 h-1 transition-all', i === 0 ? 'bg-orange' : 'bg-white/60']}
          data-slide={i}
          aria-label={`スライド${i + 1}`}
          type="button"
        />
      ))}
    </div>
  </section>

  <style>
    /* ヒーロー右側の画像の左辺を斜めにカット */
    .hero-image {
      clip-path: polygon(80px 0, 100% 0, 100% 100%, 0 100%);
    }
    @media (min-width: 768px) {
      .hero-image {
        clip-path: polygon(140px 0, 100% 0, 100% 100%, 0 100%);
      }
    }
  </style>

  <!-- ========== 同友会とは ========== -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="section-title-block">
        <span class="sub">ABOUT DOYUKAI</span>
        <span class="title">同友会とは？</span>
      </div>
      <p class="text-text leading-loose text-base md:text-lg text-left md:text-center">
        同友会は中小企業を中心とする異業種の経営者が、対等平等の立場で自主的に運営しており、中小企業経営者の生の経営体験の交流と日常の様々な経営課題を克服する活動を行っています。
        全国47都道府県に組織を持ち、会員数は<strong class="text-primary">約4万7千人</strong>。東京中小企業家同友会は<strong class="text-primary">27支部・2,400名</strong>の会員で構成されています。
      </p>
    </div>
  </section>

  <!-- ========== 三多摩支部とは (3カラム) ========== -->
  <section class="py-16 md:py-20 bg-bg-gray">
    <div class="max-w-6xl mx-auto px-4">
      <div class="section-title-block">
        <span class="sub">SANTAMA BRANCH</span>
        <span class="title">東京中小企業家同友会 三多摩支部とは</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {features.map((f) => (
          <article class="bg-white rounded-md shadow-sm overflow-hidden flex flex-col">
            <a href={withBase(f.href)} class="block aspect-video overflow-hidden">
              <img
                src={withBase(f.image)}
                alt={f.title}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </a>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-lg md:text-xl font-bold text-accent mb-3 border-b-2 border-orange pb-2 inline-block">
                {f.title}
              </h3>
              <p class="text-sm text-text-light leading-relaxed flex-1">{f.text}</p>
              <a
                href={withBase(f.href)}
                class="mt-4 inline-flex items-center gap-1 text-primary font-bold text-sm hover:text-primary-dark transition-colors"
              >
                詳しく見る
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== お問い合わせ誘導 (細帯) ========== -->
  <section class="py-10 md:py-12 bg-white border-t border-b border-border">
    <div class="max-w-4xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-center md:text-left">
        <svg class="w-8 h-8 text-primary hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <div>
          <h3 class="text-lg md:text-xl font-bold text-accent">お問い合わせ</h3>
          <p class="text-sm text-text-light">三多摩支部へのお問い合わせ、入会案内はこちらから。</p>
        </div>
      </div>
      <a
        href={withBase('/contact/')}
        class="inline-block px-6 py-3 bg-primary text-white font-bold rounded hover:bg-primary-dark transition-colors"
      >
        お問い合わせ →
      </a>
    </div>
  </section>

  <!-- ========== 例会お試し参加 CTA (ダークネイビー帯) ========== -->
  <section class="py-14 md:py-20 bg-accent text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 leading-snug">
        経営者勉強会（例会）に<br class="md:hidden" />お試し参加しませんか？
      </h2>
      <p class="text-white/80 mb-8 leading-relaxed">
        三多摩支部の雰囲気を体感していただけるよう、ゲスト参加を歓迎しています。<br />
        まずは次回の例会情報をご覧ください。
      </p>
      <a
        href={withBase('/welcome/')}
        class="inline-block px-8 py-4 bg-orange text-white font-bold rounded shadow-lg hover:opacity-90 transition-opacity text-lg"
      >
        次の例会情報を見る →
      </a>
    </div>
  </section>

  <!-- ========== 最新活動状況 ========== -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="section-title-block">
        <span class="sub">LATEST NEWS</span>
        <span class="title">最新活動状況</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestPosts.map((post) => (
          <article class="bg-white border border-border rounded-md overflow-hidden hover:shadow-md transition-shadow flex flex-col">
            <a href={withBase(`/${post.category}/${post.slug}/`)} class="block aspect-video bg-bg-gray overflow-hidden">
              {post.eyecatch ? (
                <img src={post.eyecatch.url} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-border">
                  <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
            </a>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-2">
                <time class="text-xs text-text-light">{formatDate(post.publishedAt)}</time>
                <span class="text-xs bg-primary-light text-primary px-2 py-0.5 rounded font-medium">
                  {categoryLabels[post.category] || post.category}
                </span>
              </div>
              <h3 class="font-bold text-text leading-snug line-clamp-3 flex-1">
                <a href={withBase(`/${post.category}/${post.slug}/`)} class="hover:text-primary transition-colors">
                  {post.title}
                </a>
              </h3>
            </div>
          </article>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={withBase('/posts/')}
          class="inline-flex items-center gap-2 px-6 py-3 border-2 border-primary text-primary font-bold rounded hover:bg-primary hover:text-white transition-colors"
        >
          活動状況の一覧を見る →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ========== Hero Slider ==========
  const sliderTrack = document.querySelector('.slider-track') as HTMLElement;
  const dots = document.querySelectorAll('.slider-dot');
  let currentSlide = 0;
  const totalSlides = dots.length;
  let autoplayTimer: ReturnType<typeof setInterval>;

  function goToSlide(index: number) {
    currentSlide = index;
    sliderTrack.style.transform = `translateX(-${currentSlide * (100 / totalSlides)}%)`;
    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.remove('bg-white/60');
        dot.classList.add('bg-orange');
      } else {
        dot.classList.add('bg-white/60');
        dot.classList.remove('bg-orange');
      }
    });
  }

  function nextSlide() {
    goToSlide((currentSlide + 1) % totalSlides);
  }

  function prevSlide() {
    goToSlide((currentSlide - 1 + totalSlides) % totalSlides);
  }

  function startAutoplay() {
    autoplayTimer = setInterval(nextSlide, 5000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const slideIndex = parseInt((dot as HTMLElement).dataset.slide || '0');
      goToSlide(slideIndex);
      resetAutoplay();
    });
  });

  document.querySelector('.slider-prev')?.addEventListener('click', () => {
    prevSlide();
    resetAutoplay();
  });
  document.querySelector('.slider-next')?.addEventListener('click', () => {
    nextSlide();
    resetAutoplay();
  });

  if (sliderTrack && totalSlides > 0) {
    startAutoplay();
  }

  document.getElementById('hero-slider')?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      prevSlide();
      resetAutoplay();
    } else if (e.key === 'ArrowRight') {
      nextSlide();
      resetAutoplay();
    }
  });
</script>
