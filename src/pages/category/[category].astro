---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostCard from '../../components/PostCard.astro';
import HeroSection from '../../components/HeroSection.astro';
import { getFiscalYear, getFiscalYears, getPostsByFiscalYear, getFiscalYearLabel } from '../../lib/microcms';
import { withBase } from '../../lib/path';

export async function getStaticPaths() {
  const years = await getFiscalYears();
  return years.map((year) => ({
    params: { category: String(year) },
    props: { year },
  }));
}

interface Props {
  year: number;
}

const { year } = Astro.props;
const categoryLabel = getFiscalYearLabel(year);
const filteredPosts = await getPostsByFiscalYear(year);

const years = await getFiscalYears();
const categoryFilters = [
  { label: '全て', href: '/posts/', key: 'all' },
  ...years.map((y) => ({
    label: String(y),
    href: `/category/${y}/`,
    key: String(y),
  })),
];
---

<BaseLayout title={categoryLabel}>
  <Breadcrumb items={[
    { label: '最新活動状況', href: '/posts/' },
    { label: categoryLabel },
  ]} />

  <HeroSection title={categoryLabel} />

  <section class="max-w-5xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-8">
      {categoryFilters.map((filter) => (
        <a
          href={withBase(filter.href)}
          class:list={[
            'px-4 py-2 rounded text-sm font-medium transition-colors',
            filter.key === String(year)
              ? 'bg-primary text-white'
              : 'bg-bg-gray text-text-light hover:bg-primary-light hover:text-primary',
          ]}
        >
          {filter.label}
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {filteredPosts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug}
          category={post.category}
          year={getFiscalYear(post)}
          publishedAt={post.publishedAt}
          eventDate={post.eventDate}
          excerpt={post.excerpt}
          eyecatch={post.eyecatch}
        />
      ))}
    </div>

    <div class="mt-8 text-center text-sm text-text-light">
      全 {filteredPosts.length} 件
    </div>
  </section>
</BaseLayout>
