---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostCard from '../../components/PostCard.astro';
import HeroSection from '../../components/HeroSection.astro';
import { getAllPosts, getFiscalYear, getFiscalYears } from '../../lib/microcms';
import { withBase } from '../../lib/path';

const sortedPosts = await getAllPosts();
const years = await getFiscalYears();

const categoryFilters = [
  { label: '全て', href: '/posts/', key: 'all' },
  ...years.map((year) => ({
    label: String(year),
    href: `/category/${year}/`,
    key: String(year),
  })),
];
---

<BaseLayout title="最新活動状況">
  <Breadcrumb items={[{ label: '最新活動状況' }]} />

  <HeroSection title="最新活動状況" />

  <section class="max-w-5xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-8">
      {categoryFilters.map((filter) => (
        <a
          href={withBase(filter.href)}
          class:list={[
            'px-4 py-2 rounded text-sm font-medium transition-colors',
            filter.key === 'all'
              ? 'bg-primary text-white'
              : 'bg-bg-gray text-text-light hover:bg-primary-light hover:text-primary',
          ]}
        >
          {filter.label}
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="posts-grid">
      {sortedPosts.map((post, i) => (
        <div class="post-item" style={i >= 10 ? 'display:none' : undefined}>
          <PostCard
            title={post.title}
            slug={post.slug}
            category={post.category}
            year={getFiscalYear(post)}
            publishedAt={post.publishedAt}
            eventDate={post.eventDate}
            excerpt={post.excerpt}
            eyecatch={post.eyecatch}
          />
        </div>
      ))}
    </div>

    {sortedPosts.length > 10 && (
      <div class="mt-8 text-center">
        <button
          id="load-more"
          class="px-6 py-2.5 rounded bg-primary text-white text-sm font-medium hover:bg-accent transition-colors"
        >
          もっと見る
        </button>
      </div>
    )}

    <div class="mt-8 text-center text-sm text-text-light">
      全 {sortedPosts.length} 件
    </div>
  </section>

  <script>
    const STEP = 10;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.post-item'));
    const btn = document.getElementById('load-more');
    let shown = STEP;
    btn?.addEventListener('click', () => {
      for (let i = shown; i < shown + STEP && i < items.length; i++) {
        items[i].style.display = '';
      }
      shown += STEP;
      if (shown >= items.length) btn.style.display = 'none';
    });
  </script>
</BaseLayout>
