---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import MemberTable from '../components/MemberTable.astro';
import HeroSection from '../components/HeroSection.astro';
import { getAllMembers } from '../lib/microcms';

const members = await getAllMembers();
---

<BaseLayout title="会員一覧">
  <Breadcrumb items={[{ label: '会員一覧' }]} />

  <HeroSection title="会員一覧" subtitle="東京中小企業家同友会 三多摩支部に所属する会員企業をご紹介します。多摩地域を中心に、さまざまな業種の中小企業が活動しています。" />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4">
      <MemberTable members={members} />

      <p class="mt-8 text-sm text-text-light">※ 掲載情報は2025年4月現在のものです</p>
    </div>
  </section>
</BaseLayout>
