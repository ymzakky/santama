---
import type { MemberProfile } from '../lib/microcms';
import { withBase, resolveAssetUrl } from '../lib/path';

interface Props {
  member: MemberProfile;
}
const { member } = Astro.props;
const href = withBase(`/members/${member.slug}/`);
const face = member.faceImage;
---

<article class="bg-white rounded-lg shadow-sm border border-border overflow-hidden hover:shadow-md transition-shadow flex flex-col">
  <a href={href} class="block aspect-[4/3] bg-bg-gray overflow-hidden">
    {face ? (
      <img
        src={resolveAssetUrl(face.url)}
        alt={face.alt ?? `${member.company} ${member.name}さん`}
        class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-border">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
    )}
  </a>
  <div class="p-5 flex flex-col flex-1">
    <span class="text-xs bg-primary-light text-primary px-2 py-0.5 rounded font-medium self-start mb-2">
      {member.business}
    </span>
    <h3 class="font-bold text-text mb-1 leading-snug">
      <a href={href} class="hover:text-primary transition-colors">
        {member.company}
      </a>
    </h3>
    <p class="text-sm text-text-light mb-3">
      {member.position}　{member.name}
    </p>
    <p class="text-xs text-text-light mt-auto">{member.location}</p>
  </div>
</article>
