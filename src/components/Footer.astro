---
import { footerNavItems as navItems } from '../lib/microcms';
import { withBase } from '../lib/path';
---

<footer class="bg-accent text-white">
  <div class="max-w-6xl mx-auto px-4 py-14">
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Logo & Description -->
      <div class="md:col-span-1">
        <div class="mb-4 bg-white inline-block p-2 rounded">
          <img src={withBase('/images/logo.png')} alt="東京中小企業家同友会 三多摩支部" class="h-10" />
        </div>
        <p class="text-sm text-white/80 leading-relaxed">
          東京中小企業家同友会 三多摩支部では、多数の中小企業の経営者の皆様にご入会頂いております。多様な会員同士の交流の中で、経営者の学びや他業種への理解を深めることができます。
        </p>
      </div>

      <!-- Sitemap -->
      <div>
        <h3 class="font-bold mb-4 text-sm border-l-4 border-orange pl-2">サイトマップ</h3>
        <ul class="space-y-2">
          {navItems.map(item => (
            <li>
              <a href={withBase(item.href)} class="text-sm text-white/80 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div>
        <h3 class="font-bold mb-4 text-sm border-l-4 border-orange pl-2">お問い合わせ</h3>
        <p class="text-sm text-white/80 mb-4 leading-relaxed">
          入会に関するご質問、例会のお試し参加など、お気軽にお問い合わせください。
        </p>
        <a href={withBase('/contact/')} class="inline-block px-6 py-3 bg-orange text-white text-sm font-bold rounded hover:opacity-90 transition-opacity">
          お問い合わせはこちら →
        </a>
      </div>
    </div>
    <div class="border-t border-white/20 mt-10 pt-6 text-center">
      <p class="text-xs text-white/60">&copy; 東京中小企業家同友会 三多摩支部. All Rights Reserved.</p>
    </div>
  </div>

  <!-- Page top button -->
  <button
    id="page-top"
    class="fixed bottom-6 right-6 w-12 h-12 bg-primary text-white rounded-full shadow-lg hover:bg-primary-dark transition-colors opacity-0 pointer-events-none z-40"
    aria-label="ページトップへ"
  >
    <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>
</footer>

<script>
  const topBtn = document.getElementById('page-top');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      topBtn?.classList.remove('opacity-0', 'pointer-events-none');
      topBtn?.classList.add('opacity-100');
    } else {
      topBtn?.classList.add('opacity-0', 'pointer-events-none');
      topBtn?.classList.remove('opacity-100');
    }
  });
  topBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
