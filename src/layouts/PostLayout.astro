---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getFiscalYear } from '../lib/microcms';
import { withBase } from '../lib/path';
import { formatDate } from '../lib/date';
import type { MicroCMSImage } from 'microcms-js-sdk';

interface Props {
  title: string;
  publishedAt: string;
  category: string;
  body: string;
  excerpt?: string;
  eyecatch?: MicroCMSImage;
  subtitle?: string;
  eventDate?: string;
  reporter?: string;
  reporterCompany?: string;
  reporterBusiness?: string;
  thumbnail?: MicroCMSImage[];
}

const {
  title,
  publishedAt,
  body,
  excerpt,
  eyecatch,
  subtitle,
  eventDate,
  reporter,
  reporterCompany,
  reporterBusiness,
  thumbnail,
} = Astro.props;

// 複数画像 (microCMS の「複数画像」フィールド = MicroCMSImage[])。空配列・未設定は表示しない。
const gallery = (thumbnail ?? []).filter((img) => img && img.url);

const url = Astro.url.href;
const fiscalYear = getFiscalYear({ eventDate, publishedAt });
const formattedPublishedAt = formatDate(publishedAt);
const formattedEventDate = formatDate(eventDate);
const hasReporterInfo = !!(reporter || reporterCompany || reporterBusiness);
---

<BaseLayout title={title}>
  <Breadcrumb items={[
    { label: '最新活動状況', href: '/posts/' },
    { label: title },
  ]} />

  <article class="max-w-3xl mx-auto px-4 py-10 md:py-14">

    <!-- ===== カテゴリラベル + 日付 ===== -->
    <div class="flex items-center gap-3 mb-4">
      <span class="text-xs bg-orange text-white px-3 py-1 rounded-full font-bold">
        {fiscalYear}年度
      </span>
      <time class="text-sm text-text-light">{formattedPublishedAt}</time>
    </div>

    <!-- ===== タイトル (左にオレンジ縦帯) ===== -->
    <h1 class="text-xl md:text-2xl font-bold leading-snug text-accent mb-4 pl-4 border-l-4 border-orange">
      {title}
    </h1>

    <!-- ===== サブタイトル ===== -->
    {subtitle && (
      <p class="text-base md:text-lg text-primary font-bold mb-6 leading-relaxed">
        {subtitle}
      </p>
    )}

    <!-- ===== 報告者情報ボックス (microCMSでフィールド入力時のみ表示) ===== -->
    {hasReporterInfo && (
      <div class="bg-bg-gray border-l-4 border-primary rounded-r p-5 mb-8">
        <dl class="grid grid-cols-1 sm:grid-cols-[6rem_1fr] gap-x-4 gap-y-2 text-sm">
          {reporter && (
            <>
              <dt class="font-bold text-accent">報告者</dt>
              <dd class="text-text">{reporter}</dd>
            </>
          )}
          {reporterCompany && (
            <>
              <dt class="font-bold text-accent">所属企業</dt>
              <dd class="text-text">{reporterCompany}</dd>
            </>
          )}
          {reporterBusiness && (
            <>
              <dt class="font-bold text-accent">事業内容</dt>
              <dd class="text-text">{reporterBusiness}</dd>
            </>
          )}
          {formattedEventDate && (
            <>
              <dt class="font-bold text-accent">例会開催日</dt>
              <dd class="text-text">{formattedEventDate}</dd>
            </>
          )}
        </dl>
      </div>
    )}

    <!-- ===== アイキャッチ画像 ===== -->
    {eyecatch ? (
      <figure class="mb-8">
        <img
          src={eyecatch.url}
          alt={title}
          width={eyecatch.width}
          height={eyecatch.height}
          class="w-full rounded-lg shadow-sm"
          loading="lazy"
        />
      </figure>
    ) : (
      <div class="aspect-video bg-bg-gray rounded-lg flex items-center justify-center mb-8">
        <svg class="w-20 h-20 text-border" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- ===== リード文 (excerpt) ===== -->
    {excerpt && (
      <p class="text-text leading-loose mb-8 pb-6 border-b border-border">
        {excerpt}
      </p>
    )}

    <!-- ===== 本文 (microCMSリッチエディタHTML) ===== -->
    <div class="prose post-body" set:html={body} />

    <!-- ===== 画像ギャラリー (thumbnail / 複数画像) ===== -->
    {gallery.length > 0 && (
      <section class="mt-12 pt-8 border-t border-border">
        <h2 class="text-lg font-bold text-accent mb-5 pl-3 border-l-4 border-orange">活動の様子</h2>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {gallery.map((img) => (
            <li>
              <button
                type="button"
                class="gallery-item group block w-full overflow-hidden rounded-lg bg-bg-gray focus:outline-none focus:ring-2 focus:ring-primary"
                data-full={img.url}
                data-alt={img.alt ?? title}
                aria-label="画像を拡大表示"
              >
                <img
                  src={`${img.url}?fit=crop&w=480&h=360`}
                  alt={img.alt ?? title}
                  width="480"
                  height="360"
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-200 group-hover:scale-105"
                />
              </button>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- ===== SNSシェア ===== -->
    <div class="mt-12 pt-6 border-t border-border">
      <p class="text-sm font-bold text-accent mb-3 text-center">この内容をシェアする</p>
      <ShareButtons url={url} title={title} />
    </div>

    <!-- ===== 一覧に戻る ===== -->
    <div class="mt-10 text-center">
      <a href={withBase('/posts/')} class="inline-flex items-center gap-2 px-6 py-3 border-2 border-primary text-primary font-bold rounded hover:bg-primary hover:text-white transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        最新活動状況の一覧に戻る
      </a>
    </div>
  </article>

  <!-- ===== 画像拡大モーダル ===== -->
  {gallery.length > 0 && (
    <div
      id="image-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-label="画像の拡大表示"
    >
      <button
        id="image-modal-close"
        type="button"
        class="absolute top-4 right-4 text-white/90 hover:text-white p-2 rounded-full focus:outline-none focus:ring-2 focus:ring-white"
        aria-label="閉じる"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img
        id="image-modal-img"
        src=""
        alt=""
        class="max-w-full max-h-[90vh] object-contain rounded shadow-lg"
      />
    </div>
  )}
</BaseLayout>

<script>
  // 画像ギャラリー: サムネイルをクリックすると元サイズの画像をモーダル表示
  const modal = document.getElementById('image-modal');
  const modalImg = document.getElementById('image-modal-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('image-modal-close');

  if (modal && modalImg) {
    const open = (full: string, alt: string) => {
      modalImg.src = full;
      modalImg.alt = alt;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modalImg.src = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(btn.dataset.full ?? '', btn.dataset.alt ?? '');
      });
    });

    closeBtn?.addEventListener('click', close);
    // 背景(オーバーレイ)クリックで閉じる。画像自体のクリックは閉じない。
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    // Esc キーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });
  }
</script>

<style is:global>
  /* 記事本文の小見出し (microCMSで <h2>■講演概要</h2> のように書かれた箇所を装飾) */
  .post-body h2 {
    font-size: 1.25rem;
    color: var(--color-accent);
    border-left: 6px solid var(--color-orange);
    padding-left: 0.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: none;
  }
  .post-body h3 {
    font-size: 1.125rem;
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary-light);
    padding-bottom: 0.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .post-body img {
    border-radius: 0.5rem;
    margin: 1.5rem auto;
    display: block;
    max-width: 100%;
    height: auto;
  }
  .post-body p {
    margin-bottom: 1.25rem;
    line-height: 1.9;
  }
  .post-body a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .post-body a:hover {
    color: var(--color-primary-dark);
  }
</style>
